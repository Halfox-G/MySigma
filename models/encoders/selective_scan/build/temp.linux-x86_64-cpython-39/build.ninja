ninja_required_version = 1.3
cxx = c++
nvcc = /usr/local/cuda/bin/nvcc

cflags = -pthread -B /openbayes/home/envs/compiler_compat -Wno-unused-result -Wsign-compare -DNDEBUG -O2 -Wall -fPIC -O2 -isystem /openbayes/home/envs/include -I/openbayes/home/envs/include -fPIC -O2 -isystem /openbayes/home/envs/include -fPIC -I/output/Sigma/models/encoders/selective_scan/csrc/selective_scan -I/openbayes/home/envs/lib/python3.9/site-packages/torch/include -I/openbayes/home/envs/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/openbayes/home/envs/include/python3.9 -c
post_cflags = -O3 -std=c++17 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1016"' -DTORCH_EXTENSION_NAME=selective_scan_cuda_core -D_GLIBCXX_USE_CXX11_ABI=1
cuda_cflags = -I/output/Sigma/models/encoders/selective_scan/csrc/selective_scan -I/openbayes/home/envs/lib/python3.9/site-packages/torch/include -I/openbayes/home/envs/lib/python3.9/site-packages/torch/include/torch/csrc/api/include -I/usr/local/cuda/include -I/openbayes/home/envs/include/python3.9 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -O3 -std=c++17 -U__CUDA_NO_HALF_OPERATORS__ -U__CUDA_NO_HALF_CONVERSIONS__ -U__CUDA_NO_BFLOAT16_OPERATORS__ -U__CUDA_NO_BFLOAT16_CONVERSIONS__ -U__CUDA_NO_BFLOAT162_OPERATORS__ -U__CUDA_NO_BFLOAT162_CONVERSIONS__ --expt-relaxed-constexpr --expt-extended-lambda --use_fast_math --ptxas-options=-v -lineinfo -gencode arch=compute_70,code=sm_70 -gencode arch=compute_80,code=sm_80 -gencode arch=compute_90,code=sm_90 --threads 4 -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1016"' -DTORCH_EXTENSION_NAME=selective_scan_cuda_core -D_GLIBCXX_USE_CXX11_ABI=1
cuda_dlink_post_cflags = 
sycl_dlink_post_cflags = 
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc --generate-dependencies-with-compile --dependency-output $out.d $cuda_cflags -c $in -o $out $cuda_post_cflags







build /output/Sigma/models/encoders/selective_scan/build/temp.linux-x86_64-cpython-39/csrc/selective_scan/selective_scan.o: compile /output/Sigma/models/encoders/selective_scan/csrc/selective_scan/selective_scan.cpp
build /output/Sigma/models/encoders/selective_scan/build/temp.linux-x86_64-cpython-39/csrc/selective_scan/selective_scan_core.o: cuda_compile /output/Sigma/models/encoders/selective_scan/csrc/selective_scan/selective_scan_core.cu
build /output/Sigma/models/encoders/selective_scan/build/temp.linux-x86_64-cpython-39/csrc/selective_scan/selective_scan_core_fwd2.o: cuda_compile /output/Sigma/models/encoders/selective_scan/csrc/selective_scan/selective_scan_core_fwd2.cu
build /output/Sigma/models/encoders/selective_scan/build/temp.linux-x86_64-cpython-39/csrc/selective_scan/selective_scan_core_fwd3.o: cuda_compile /output/Sigma/models/encoders/selective_scan/csrc/selective_scan/selective_scan_core_fwd3.cu
build /output/Sigma/models/encoders/selective_scan/build/temp.linux-x86_64-cpython-39/csrc/selective_scan/selective_scan_core_fwd4.o: cuda_compile /output/Sigma/models/encoders/selective_scan/csrc/selective_scan/selective_scan_core_fwd4.cu








